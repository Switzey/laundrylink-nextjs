{
  "name": "laundrylink-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:setup": "node scripts/setup-database.mjs",
    "db:setup:turso": "node scripts/setup-turso.mjs",
    "db:migrate:security": "node scripts/migrate-security.mjs",
    "db:migrate:onboarding": "node scripts/migrate-onboarding.mjs",
    "user:set-password": "node scripts/set-user-password.mjs",
    "predev": "node scripts/setup-database.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/setup-database.mjs",
    "build": "next build",
    "prestart": "node scripts/setup-database.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --omit=dev --audit-level=moderate",
    "security:audit:all": "npm audit --audit-level=moderate",
    "check": "npm run typecheck && npm run lint && npm run security:audit && npm run build"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
