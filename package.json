{
  "name": "laundrylink-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "db:setup": "node scripts/setup-database.mjs",
    "db:setup:turso": "node scripts/setup-turso.mjs",
    "db:migrate:security": "node scripts/migrate-security.mjs",
    "db:migrate:onboarding": "node scripts/migrate-onboarding.mjs",
    "db:migrate:phone": "node scripts/migrate-phone-verification.mjs",
    "db:audit:phone": "node scripts/audit-phone-verification.mjs",
    "db:check-migrations": "node scripts/check-migration-compatibility.mjs",
    "user:set-password": "node scripts/set-user-password.mjs",
    "predev": "node scripts/setup-database.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/setup-database.mjs",
    "build": "next build",
    "prestart": "node scripts/setup-database.mjs",
    "start": "next start",
    "lint": "eslint src scripts tests types next.config.ts eslint.config.mjs vitest.config.mts playwright.config.ts playwright.live.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:live:headed": "playwright test --config=playwright.live.config.ts --headed",
    "test:e2e:live:report": "playwright show-report playwright-report/live",
    "playwright:agents": "playwright init-agents --loop=codex",
    "check:all": "npm run check && npm run test:e2e",
    "production:check": "node scripts/check-production-readiness.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=moderate",
    "security:audit:all": "npm audit --audit-level=moderate",
    "check": "npm run typecheck && npm run lint && npm test && npm run security:audit && npm run build"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
