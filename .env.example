# Runtime identity. Use development locally, staging for Vercel previews, and production for the live site.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=
LOG_LEVEL=info

# Secret salt used to pseudonymize IP addresses in security records. Generate at least 32 random bytes.
AUDIT_LOG_SALT=

# Session and password policy.
SESSION_DAYS=7
BCRYPT_COST=12
SESSION_COOKIE_NAME=

# Transactional authentication email (verification and password reset).
RESEND_API_KEY=
AUTH_EMAIL_FROM=LaundryLink <auth@example.com>

# OAuth/OpenID Connect. Register callback URLs as:
# /api/auth/oauth/google/callback and /api/auth/oauth/apple/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# SMS verification for vendor and rider identities.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional stable Server Action encryption key for non-Vercel multi-instance hosting.
# Vercel manages this automatically. Generate a base64-encoded 32-byte value elsewhere.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Optional absolute path to a local development SQLite database.
DATABASE_PATH=

# Hosted SQLite database. Use a separate Turso database for staging and production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local demo seeding only. Never use a shared or production account password here.
DEMO_PASSWORD=
